# Base path for Next.js application
# GitHub Pages: set to your repository name (e.g., '/uaf_lp_1')
# Custom domain: leave empty ('')
# Local development: leave empty ('')
NEXT_PUBLIC_BASE_PATH=

# Asset prefix for static files
# Should match BASE_PATH with trailing slash when BASE_PATH is set
# Leave empty when BASE_PATH is empty
NEXT_PUBLIC_ASSET_PREFIX= 